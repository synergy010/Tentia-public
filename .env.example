# ==========================================
# Meme Coin Analyzer Bot - Environment Configuration
# ==========================================

# Telegram Bot Token (obtained from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Payment & Community Settings
PAYMENT_AMOUNT=0.2 SOL
PAYMENT_WALLET=your_solana_receiving_wallet_address_here
GROUP_LINK=https://t.me/your_alerts_group_invite_link
GROUP_NAME=Tentia Coin Alerts

# Rate Limiting (in seconds)
RATE_LIMIT_SECONDS=20
RATE_LIMIT_RUGCHECK_SECONDS=20

# Solana Configuration
# Default public RPC: https://api.mainnet-beta.solana.com (or use Helius / QuickNode)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
EXPECTED_MINIMUM_SOL=0.19

# Supabase Configuration (for subscription tracking)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Moralis API Key (for OHLCV chart data)
MORALIS_API_KEY=your_moralis_api_key_here

